{
  "name": "static-analysis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Static analysis AI agent + MCP server for Web/JS bundles (Bug Bounty, no target traffic). See docs/design.md.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "smoke": "node packages/cli/scripts/smoke.mjs && node packages/mcp/scripts/smoke.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm depcruise"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
